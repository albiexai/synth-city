#!/usr/bin/python3 -I
"""Run one allowlisted workspace trust request under the factory agent account."""
from __future__ import annotations

import importlib
import json
import os
import pwd
import sys
from pathlib import Path
from types import ModuleType
from typing import BinaryIO

PROC = Path("/proc")
MAX_REQUEST_BYTES = 16384


class ConfigBusy(Exception):
    """A Claude Code session may still be using its config."""


def agent_home(agent_user: str) -> Path:
    account = pwd.getpwnam(agent_user)
    if not account.pw_uid or account.pw_uid != os.getuid() or account.pw_uid != os.geteuid():
        raise ValueError("Refusing to run as another user")
    return Path(account.pw_dir)


def load_install_module(name: str) -> ModuleType:
    # The operator installs the reviewed writer and interpreter under the
    # root-owned install root. Neither the cwd nor the request selects code.
    directory = Path(__file__).resolve().parent
    if not (directory / f"{name}.py").is_file():
        raise ImportError("Missing installed agent-config module")
    sys.path.insert(0, str(directory))
    return importlib.import_module(name)


def load_policy():
    return load_install_module("agent_config_settings").load_agent_config_settings()


def load_writer() -> ModuleType:
    return load_install_module("team_workspace_trust")


def use_install_python(helper: Path) -> None:
    venv = (helper.parent.parent / "venv").resolve()
    if Path(sys.prefix).resolve() != venv:
        python = str(venv / "bin" / "python")
        os.execv(python, [python, "-I", str(helper)])


def no_duplicate_fields(pairs: list[tuple[str, object]]) -> dict[str, object]:
    fields = dict(pairs)
    if len(fields) != len(pairs):
        raise ValueError("Duplicate request field")
    return fields


def read_request(stdin: BinaryIO) -> dict[str, object]:
    data = stdin.read(MAX_REQUEST_BYTES + 1)
    if len(data) > MAX_REQUEST_BYTES:
        raise ValueError("Request too large")
    request = json.loads(data, object_pairs_hook=no_duplicate_fields)
    if not isinstance(request, dict) or not isinstance(request.get("folder"), str):
        raise ValueError("Unsupported request")
    if (request.keys() == {"operation", "provider", "folder"} and request["operation"] == "folder_trust"
            and request["provider"] in ("codex-cli", "claude-code")):
        return request
    if (request.keys() == {"operation", "folder", "repo", "device", "inode"}
            and request["operation"] == "dispatch_git_trust" and isinstance(request["repo"], str)
            and type(request["device"]) is int and request["device"] >= 0
            and type(request["inode"]) is int and request["inode"] > 0):
        return request
    raise ValueError("Unsupported request")


def ensure_claude_idle() -> None:
    uid = str(os.getuid()).encode()
    try:
        for process in PROC.iterdir():
            if not process.name.isascii() or not process.name.isdecimal():
                continue
            try:
                with (process / "status").open("rb") as stream:
                    fields = dict(line.split(b":", 1) for line in stream.read(4096).splitlines() if b":" in line)
                uids = fields[b"Uid"].split()
                if uid not in uids[:2] or fields[b"State"].lstrip().startswith(b"Z"):
                    continue
                if fields[b"Name"].strip() == b"claude":
                    raise ConfigBusy
                with (process / "cmdline").open("rb") as stream:
                    argv = stream.read(4096).split(b"\0", 2)
            except (FileNotFoundError, ProcessLookupError):
                continue
            if (argv[0].rsplit(b"/", 1)[-1] == b"claude"
                    or (len(argv) >= 2 and argv[0].rsplit(b"/", 1)[-1] == b"node"
                        and (argv[1].rsplit(b"/", 1)[-1] == b"claude"
                             or argv[1].endswith(b"/@anthropic-ai/claude-code/cli.js")))):
                raise ConfigBusy
    except (OSError, KeyError) as exc:
        raise ConfigBusy from exc


def main(argv: list[str], stdin: BinaryIO, *, installed: bool = False) -> int:
    try:
        if argv:
            raise ValueError("This command takes no arguments")
        policy = load_policy()
        if installed:
            helper = Path(__file__).resolve()
            if helper != Path(policy.agent_config_helper_path).resolve():
                raise ValueError("Installed helper does not match agent-config policy")
            use_install_python(helper)
        request = read_request(stdin)
        home = agent_home(policy.agent_config_agent_user)
        work_root = Path(policy.agent_config_work_root)
        user_uid = os.getuid()
        writer = load_writer()
        user = writer.NativeUser(home, user_uid, {})
        if request["operation"] == "folder_trust":
            provider = request["provider"]
            guard = ensure_claude_idle if provider == "claude-code" else None
            if guard is not None:
                guard()
            changed = writer.prepare_workspace_trust(
                provider, request["folder"], user=user, work_root=work_root, before_write=guard)
        else:
            changed = writer.prepare_dispatch_git_trust(
                request["folder"], request["repo"], (request["device"], request["inode"]),
                user=user, work_root=work_root)
    except ConfigBusy:
        print(json.dumps({"ok": False, "error": "agent_config_busy"}))
        return 75
    except (OSError, ValueError, KeyError, ImportError, RecursionError):
        print(json.dumps({"ok": False, "error": "agent_config_refused"}))
        return 1
    print(json.dumps({"ok": True, "changed": changed}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], sys.stdin.buffer, installed=True))
