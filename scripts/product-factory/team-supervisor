#!/usr/bin/python3
"""Supervise one configured team. Preserve work and never change its roster."""
import argparse
import datetime
import hashlib
import json
import os
import pathlib
import pwd
import re
import signal
import sqlite3
import stat
import tempfile
import time
import urllib.parse
import urllib.request

def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()

def process(pid):
    path = pathlib.Path('/proc') / str(pid)
    raw = (path / 'stat').read_text()
    fields = raw[raw.rindex(')') + 2:].split()
    return int(fields[1]), fields[19], path.stat().st_uid

def save(path, data):
    path = pathlib.Path(path)
    fd, staging = tempfile.mkstemp(prefix='.team-supervisor-', dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w') as stream:
            stream.write(json.dumps(data, indent=2) + '\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(staging, path)
    finally:
        try:
            os.unlink(staging)
        except FileNotFoundError:
            pass

NOTICES = {
    'cybersecurity_notice': re.compile(r'this content was flagged for possible cybersecurity risk', re.I),
    'cyber_authorization_notice': re.compile(r'to get authorized for security work.{0,100}trusted access for cyber', re.I | re.S),
}
ERROR_CODES = {'content_policy_violation', 'safety_check_failed', 'cybersecurity_block', 'cybersecurity_blocked'}

def notice(record):
    # A quoted instruction or a tool result must not create a safety hold.
    kind = record.get('type')
    if kind == 'assistant':
        message = record.get('message') or {}
        content = message.get('content', [])
        if isinstance(content, list):
            text = '\n'.join(b.get('text', '') for b in content if isinstance(b, dict) and b.get('type') == 'text')
        else:
            text = str(content)
        for rule, pattern in NOTICES.items():
            if pattern.search(text):
                return rule
        if record.get('isApiErrorMessage'):
            code = _error_code(text)
            if code:
                return code
    if kind == 'system' and record.get('subtype') == 'api_error':
        error = record.get('error') or {}
        if isinstance(error, dict):
            for field in ['code', 'type']:
                if error.get(field) in ERROR_CODES:
                    return error[field]
    if kind == 'event_msg':
        payload = record.get('payload') or {}
        if payload.get('type') in {'error', 'warning', 'stream_error', 'agent_message'}:
            text = str(payload.get('message', ''))
            found = _match(text)
            if found:
                return found
            if payload.get('type') in {'error', 'stream_error'}:
                code = _error_code(text + '\n' + str(payload.get('codex_error_info', '')))
                if code:
                    return code
        # Codex 0.159: the agent's own text arrives as a completed AgentMessage item.
        item = payload.get('item') if payload.get('type') == 'item_completed' else None
        if isinstance(item, dict) and item.get('type') == 'AgentMessage':
            return _match(_texts(item.get('content')))
    if record.get('payload_type') == 'runtime.session':
        # Muse Code: the agent's own reply is assistant_message_committed. The user's
        # prompt, task output (tool results) and reasoning (which can quote the
        # prompt) are not checked.
        event = (record.get('payload') or {}).get('event') or {}
        if event.get('kind') == 'assistant_message_committed':
            return _match(str(event.get('text', '')))
        if event.get('kind') in {'error', 'model_failed', 'stream_error'}:
            text = str(event.get('message', ''))
            return _match(text) or _error_code(text)
        return None
    if kind == 'PLANNER_RESPONSE':
        # Antigravity CLI (#984): only the model's own reply text. antigravity_record() has
        # already refused every unobserved shape, so tool calls and other steps never get here
        # with text to match.
        content = record.get('content')
        if record.get('source') == 'MODEL' and isinstance(content, str):
            return _match(content)
        return None
    if kind == 'response_item':
        # Codex 0.159: the assistant message. Tool output and user input are not checked.
        payload = record.get('payload') or {}
        if payload.get('type') == 'message' and payload.get('role') == 'assistant':
            return _match(_texts(payload.get('content')))
    return None

def _texts(content):
    if not isinstance(content, list):
        return ''
    return '\n'.join(str(block.get('text', '')) for block in content if isinstance(block, dict))

def _error_code(text):
    # Longest first: cybersecurity_block is a prefix of cybersecurity_blocked.
    lowered = text.lower()
    for code in sorted(ERROR_CODES, key=lambda value: (-len(value), value)):
        if code in lowered:
            return code
    return None

def _match(text):
    for rule, pattern in NOTICES.items():
        if pattern.search(text):
            return rule
    return None

# Antigravity CLI (#984 Part 1). Observed shapes only: the #737 fixtures from agy 1.5.9 in an
# isolated runtime with a stub model. Everything else is unproven, including an ERROR step,
# which was never captured, and the records agy writes for finished tool steps. An unproven
# record fails closed before the stored offset moves, so the guard never reports a normal state
# over it and reads it again on the next tick. Until those shapes are proven (#984 Part 3), a
# routine Antigravity tool record that is not in this set stops an armed team.
AGY_ID = re.compile(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}')

def antigravity_record(record):
    kind, source = record.get('type'), record.get('source')
    if (kind, source) in {('USER_INPUT', 'USER_EXPLICIT'), ('SYSTEM_MESSAGE', 'SYSTEM')}:
        return
    if (kind, source) == ('PLANNER_RESPONSE', 'MODEL'):
        if isinstance(record.get('content'), str) and 'tool_calls' not in record:
            return
        calls = record.get('tool_calls')
        if ('content' not in record and isinstance(calls, list) and calls
                and all(isinstance(call, dict) and isinstance(call.get('name'), str) for call in calls)):
            return
    raise ValueError('antigravity_record_unobserved')

# Supervisor.record returns this for a line it skips. No JSON value can equal it.
SKIP = object()

# OpenCode 2 (#733). The agent's replies live in SQLite, not a transcript file.
# Shape from pinned anomalyco/opencode fedc6f208aa2bd54c1019227214568083f6380ad (v2.2.7):
# schema.gen.ts tables; session/history.ts L91-122 (parts by ordinal, then inline
# data.content); schema/session-message.ts L185 ({type: "text", text}); the DB file is
# <data root>/opencode.db, or opencode-<channel>.db (packages/cli/src/database-path.ts).
# Matching columns validate the required shape only; they do not prove a binary version.
# Every tick rescans all assistant text, so a reopened or replaced message stays covered.
# Each limit below refuses (ValueError, which fails closed); nothing is ever skipped.
OC_SESSION_ID = re.compile(r'ses[0-9A-Za-z_-]{1,96}')
OC_HEADER = b'SQLite format 3\x00'
OC_REQUIRED = {
    'session_v2': {'id', 'directory'},
    'session_message': {'id', 'session_id', 'type', 'seq', 'data'},
    'session_part': {'message_id', 'ordinal', 'type', 'data'},
}
OC_MAX_ROOT_PATH = 4096
OC_ID_MAX = 256               # bytes per message id or part type, checked in SQL before fetch
OC_MAX_ENTRIES = 256          # directory entries examined per data root
OC_MAX_CANDIDATES = 16
OC_CELL_MAX = 1 << 20         # bytes per data cell, checked in SQL before the cell is fetched
OC_FETCH_MAX = 8 << 20        # data bytes fetched per session per tick, before decoding
OC_TEXT_MAX = 8 << 20         # UTF-8 bytes of extracted reply text per session per tick
OC_MAX_MESSAGES = 2000
OC_MAX_PARTS = 20000
OC_VM_INTERVAL = 1000         # SQLite progress-handler interval, in VM operations
OC_VM_MAX = 2000000           # total VM operations per tick
OC_BUSY_MS = 250
OC_FD_DIR = '/proc/self/fd'   # Linux: this process's own descriptors, never another process's
OC_FD_MAX = 1024              # descriptors examined per listing
OC_DEADLINE = 3.0             # seconds per tick: discovery, connections, SQL, fetch and decoding


class OpenCodeBudget:
    """One tick's deadline and VM budget, shared by every OpenCode session it scans."""

    def __init__(self):
        self.deadline = time.monotonic() + OC_DEADLINE
        self.operations = 0
        self.exceeded = None

    def check(self):
        if time.monotonic() > self.deadline:
            raise ValueError('opencode_guard_deadline')

    def progress(self):
        self.operations += OC_VM_INTERVAL
        if self.operations > OC_VM_MAX:
            self.exceeded = 'opencode_guard_budget'
        elif time.monotonic() > self.deadline:
            self.exceeded = 'opencode_guard_deadline'
        return 1 if self.exceeded else 0


def _oc_open_files(budget):
    """This process's open regular files, as {descriptor: (st_dev, st_ino)}."""
    files = {}
    try:
        with os.scandir(OC_FD_DIR) as entries:
            for index, entry in enumerate(entries):
                if index >= OC_FD_MAX:
                    raise ValueError('opencode_guard_budget')
                budget.check()
                try:
                    info = os.stat(os.path.join(OC_FD_DIR, entry.name))
                except FileNotFoundError:
                    continue  # closed meanwhile, e.g. the listing's own descriptor
                if stat.S_ISREG(info.st_mode):
                    files[entry.name] = (info.st_dev, info.st_ino)
    except OSError as exc:
        raise ValueError('opencode_db_unreadable') from exc
    return files


def _oc_json(raw):
    try:
        value = json.loads(raw)
    except (TypeError, ValueError):
        raise ValueError('opencode_record_malformed')
    if not isinstance(value, dict):
        raise ValueError('opencode_record_malformed')
    return value


def _oc_text(item):
    text = item.get('text')
    if not isinstance(text, str):
        raise ValueError('opencode_record_malformed')
    return text


class Supervisor:
    def __init__(self, config):
        self.config = config
        self.state_path = pathlib.Path(config['state_path'])
        self.hold_path = pathlib.Path(config['hold_path'])
        self.state = json.loads(self.state_path.read_text()) if self.state_path.exists() else {'offsets': {}, 'autonomy_enabled': False}

    def api(self, method, path, body=None):
        cfg = dict(line.split('=', 1) for line in pathlib.Path(self.config['operator_env']).read_text().splitlines() if '=' in line)
        request = urllib.request.Request(self.config['api'] + path, data=None if body is None else json.dumps(body).encode(), method=method, headers={'Content-Type': 'application/json', 'X-Synth-City-Operator-Token': cfg['OPERATOR_TOKEN']})
        with urllib.request.urlopen(request, timeout=8) as response:
            return json.load(response)

    def bindings(self):
        with sqlite3.connect('file:' + self.config['database'] + '?mode=ro', uri=True, timeout=2) as db:
            db.row_factory = sqlite3.Row
            rows = db.execute('SELECT b.*, s.launch_options, s.repo_path, s.provider FROM agent_pane_bindings b JOIN agent_team_slots s ON s.id=b.slot_id WHERE b.preset_id=?', (self.config['preset_id'],)).fetchall()
        live = []
        for row in rows:
            if row['slot_id'] not in self.config['slot_ids']:
                continue
            try:
                _, start, uid = process(row['pane_pid'])
            except (OSError, ValueError, IndexError):
                continue
            if start == row['pane_proc_start'] and uid == self.config['agent_uid']:
                live.append(dict(row))
        return live

    def freeze(self):
        roots = self.bindings()
        processes = {}
        for path in pathlib.Path('/proc').iterdir():
            if not path.name.isdigit():
                continue
            try:
                processes[int(path.name)] = process(int(path.name))
            except (OSError, ValueError, IndexError):
                continue
        selected = {row['pane_pid'] for row in roots}
        while True:
            added = {pid for pid, (parent, _, uid) in processes.items() if parent in selected and uid == self.config['agent_uid']}
            if added <= selected:
                break
            selected |= added
        frozen = []
        for pid in sorted(selected):
            try:
                if process(pid) != processes[pid]:
                    continue
                os.kill(pid, signal.SIGSTOP)
                frozen.append({'pid': pid, 'proc_start': processes[pid][1]})
            except (OSError, KeyError):
                pass
        return frozen

    def stop(self, reason, *, security=False, rule=None):
        event = {'time_utc': now(), 'preset_id': self.config['preset_id'], 'reason': reason, 'rule': rule, 'security_hold': security}
        if security:
            save(self.hold_path, event)
        try:
            self.api('PATCH', '/agent-teams/presets/' + str(self.config['preset_id']), {'autonomy_enabled': False})
            for scope in self.config['scope_ids']:
                self.api('PATCH', '/agent-teams/github-scopes/' + str(scope), {'enabled': False})
            event['autonomy_off_verified'] = not self.api('GET', '/agent-teams/presets/' + str(self.config['preset_id']))['autonomy_enabled']
        except Exception as exc:
            event['controller_error'] = type(exc).__name__
        try:
            event['frozen_processes'] = self.freeze()
        except Exception as exc:
            event['freeze_error'] = type(exc).__name__
        if security:
            save(self.hold_path, event)
        self.state.update(last_tick=now(), mode='WAITING_FOR_USER' if security else 'RECOVERY_REQUIRED', autonomy_enabled=False, incident=event)
        save(self.state_path, self.state)

    def scan(self, bindings):
        paths = {}
        opencode = []
        for binding in bindings:
            options = json.loads(binding['launch_options'] or '{}')
            native_id = options.get('session_id')
            if binding.get('provider') == 'opencode-cli':
                if not isinstance(native_id, str) or not OC_SESSION_ID.fullmatch(native_id):
                    raise ValueError('opencode_session_id_invalid')
                opencode.append((native_id, binding['repo_path']))
                continue
            provider = binding.get('provider') or 'claude-code'
            if not native_id or not re.fullmatch(r'[0-9a-f-]{36}', native_id):
                raise ValueError('native_session_identity_missing')
            if provider == 'antigravity-cli' and not AGY_ID.fullmatch(native_id):
                raise ValueError('native_session_identity_missing')
            paths[self.transcript(provider, binding['repo_path'], native_id)] = provider
        if opencode:
            budget = OpenCodeBudget()
            for native_id, repo_path in opencode:
                found = self.opencode_notice(native_id, repo_path, budget)
                if found:
                    self.stop('security_notice', security=True, rule=found)
                    return False
        for path, provider in paths.items():
            key = str(path)
            offset = int(self.state['offsets'].get(key, 0))
            if provider != 'antigravity-cli' and path.stat().st_size < offset:
                raise ValueError('native_transcript_shrank')
            with self.open_transcript(path, provider) as stream:
                identity = None
                if provider == 'antigravity-cli':
                    # #1020 review: size and identity come from the opened file, never the path.
                    info = os.fstat(stream.fileno())
                    identity = [info.st_dev, info.st_ino]
                    if info.st_size < offset:
                        raise ValueError('native_transcript_shrank')
                    if offset and self.state.get('native_identities', {}).get(key) != identity:
                        raise ValueError('native_transcript_replaced')
                stream.seek(offset)
                inspected = 0
                while inspected < 16 * 1024 * 1024:
                    start = stream.tell()
                    line = stream.readline(8 * 1024 * 1024)
                    if not line:
                        break
                    if not line.endswith(b'\n'):
                        stream.seek(start)
                        if len(line) == 8 * 1024 * 1024:
                            raise ValueError('native_record_too_large')
                        break
                    inspected += len(line)
                    record = self.record(line)
                    if record is SKIP:
                        continue
                    if provider == 'antigravity-cli':
                        antigravity_record(record)  # before the offset is saved below
                    found = notice(record)
                    if found:
                        self.stop('security_notice', security=True, rule=found)
                        return False
                self.state['offsets'][key] = stream.tell()
                if identity is not None:
                    self.state.setdefault('native_identities', {})[key] = identity
        return True

    def record(self, line):
        """Parse one transcript line. A crash can leave NUL bytes where it lost data.

        The NULs carry no content. The record after them is inspected as usual.
        A line that holds only NULs returns SKIP, which no parsed value can equal.
        A damaged fragment fails closed, unless the operator acknowledged that
        exact line by its SHA-256. A record that is not a JSON object fails closed.
        """
        if b'\x00' not in line:
            return self.object(json.loads(line))
        self.state['damaged_records_seen'] = self.state.get('damaged_records_seen', 0) + 1
        remainder = line.replace(b'\x00', b'').strip()
        if not remainder:
            return SKIP
        try:
            parsed = json.loads(remainder)
        except ValueError:
            if hashlib.sha256(line).hexdigest() in set(self.config.get('acknowledged_damaged_records', [])):
                return SKIP
            raise ValueError('native_record_damaged')
        return self.object(parsed)

    @staticmethod
    def object(parsed):
        # Every native record is a JSON object. Any other value fails closed.
        if not isinstance(parsed, dict):
            raise ValueError('native_record_not_object')
        return parsed

    def opencode_candidates(self, budget):
        """The safe OpenCode database files under the configured data roots."""
        roots = self.config.get('opencode_data_roots') or []
        candidates = []
        for root in roots:
            budget.check()
            if not isinstance(root, str) or not root.startswith('/') or len(root.encode()) > OC_MAX_ROOT_PATH:
                raise ValueError('opencode_db_unsafe_file')
            try:
                with os.scandir(root) as entries:
                    names = []
                    for index, entry in enumerate(entries):
                        if index >= OC_MAX_ENTRIES:
                            raise ValueError('opencode_guard_budget')
                        names.append(entry.name)
            except FileNotFoundError:
                continue
            except PermissionError:
                raise ValueError('opencode_db_unreadable')
            channel = sorted(n for n in names if n.startswith('opencode-') and n.endswith('.db') and len(n) <= 255)
            if 'opencode.db' in names:
                chosen = ['opencode.db']
            elif len(channel) == 1:
                chosen = channel
            elif channel:
                raise ValueError('opencode_db_ambiguous')
            else:
                chosen = []
            candidates.extend(os.path.join(root, name) for name in chosen)
            if len(candidates) > OC_MAX_CANDIDATES:
                raise ValueError('opencode_db_ambiguous')
        if not candidates:
            raise ValueError('opencode_db_missing')
        return candidates

    def opencode_identity(self, path):
        """A regular file the agent owns, not writable by others, with a SQLite header."""
        try:
            info = os.lstat(path)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != self.config['agent_uid'] or info.st_mode & 0o022:
                raise ValueError('opencode_db_unsafe_file')
            descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
            try:
                opened = os.fstat(descriptor)
                header = os.read(descriptor, len(OC_HEADER))
            finally:
                os.close(descriptor)
        except PermissionError:
            raise ValueError('opencode_db_unreadable')
        except OSError:
            raise ValueError('opencode_db_unsafe_file')
        if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino) or header != OC_HEADER:
            raise ValueError('opencode_db_unsafe_file')
        return [info.st_dev, info.st_ino, info.st_uid]

    def opencode_connect(self, path, identity, budget):
        """A read-only connection whose own open database file is the checked file.

        SQLite opens the main database file inside connect and keeps that descriptor for the
        connection's life. The one regular-file descriptor that appears across connect must be
        the checked inode: a path match alone could name a file swapped in and back.
        """
        before = _oc_open_files(budget)
        # Percent-encode the path: a raw '#' or '?' would end the URI early and open another file.
        db = sqlite3.connect('file:' + urllib.parse.quote(path, safe='/') + '?mode=ro', uri=True,
                             timeout=OC_BUSY_MS / 1000)
        try:
            new = {fd: file for fd, file in _oc_open_files(budget).items() if before.get(fd) != file}
            if len(new) != 1:
                raise ValueError('opencode_db_unreadable')  # missing, reused or ambiguous evidence
            [(fd, file)] = new.items()
            if file != tuple(identity[:2]):
                raise ValueError('opencode_db_replaced')
            db.execute('PRAGMA query_only = ON')
            opened = [row[2] for row in db.execute('PRAGMA database_list') if row[1] == 'main']
            if opened != [os.path.realpath(path)]:
                raise ValueError('opencode_db_unsafe_file')
            db.set_progress_handler(budget.progress, OC_VM_INTERVAL)
        except sqlite3.DatabaseError as exc:
            db.close()
            raise ValueError('opencode_db_unreadable') from exc
        except Exception:
            db.close()
            raise
        return db, fd

    @staticmethod
    def opencode_still_open(fd, identity):
        try:
            info = os.stat(os.path.join(OC_FD_DIR, fd))
        except OSError as exc:
            raise ValueError('opencode_db_unreadable') from exc
        if (info.st_dev, info.st_ino) != tuple(identity[:2]):
            raise ValueError('opencode_db_replaced')

    @staticmethod
    def opencode_query(db, budget, sql, args=()):
        budget.check()
        try:
            return db.execute(sql, args).fetchall()
        except sqlite3.OperationalError as exc:
            if budget.exceeded:
                raise ValueError(budget.exceeded)
            raise ValueError('opencode_db_unreadable') from exc
        except sqlite3.DatabaseError as exc:
            raise ValueError('opencode_db_unsafe_file') from exc

    def opencode_notice(self, native_id, repo_path, budget):
        """Check every assistant reply of one bound OpenCode session, or fail closed."""
        matches = []
        for path in self.opencode_candidates(budget):
            identity = self.opencode_identity(path)
            budget.check()
            db, _ = self.opencode_connect(path, identity, budget)
            try:
                for table, required in OC_REQUIRED.items():
                    # Only the required names come back; the agent's schema controls every other name.
                    names = sorted(required)
                    columns = {row[0] for row in self.opencode_query(
                        db, budget, 'SELECT name FROM pragma_table_info(?) WHERE name IN (%s)' % ','.join('?' * len(names)),
                        (table, *names))}
                    if not required <= columns:
                        raise ValueError('opencode_schema_unsupported')
                rows = self.opencode_query(db, budget, 'SELECT 1 FROM session_v2 WHERE id=? AND directory=? LIMIT 2',
                                           (native_id, repo_path))
            finally:
                db.close()
            if len(rows) > 1:
                raise ValueError('opencode_session_ambiguous')
            if rows:
                matches.append((path, identity))
        if not matches:
            raise ValueError('opencode_session_missing')
        if len(matches) != 1:
            raise ValueError('opencode_session_ambiguous')
        path, identity = matches[0]
        # The first observation records the file; a later change means the database was replaced.
        # Clearing a recorded identity is a separate operator action, never automatic.
        known = self.state.setdefault('opencode_db_identity', {})
        if known.get(native_id, identity) != identity:
            raise ValueError('opencode_db_replaced')
        known[native_id] = identity
        return self.opencode_scan_session(path, identity, native_id, repo_path, budget)

    def opencode_cell(self, db, budget, size, fetched, table, where, args):
        """Fetch one data cell only after its byte size fits the cell and cumulative budgets."""
        if size is None or size > OC_CELL_MAX:
            raise ValueError('opencode_record_too_large')
        fetched += size
        if fetched > OC_FETCH_MAX:
            raise ValueError('opencode_guard_budget')
        # The column check doesn't prove the pinned keys: require one row before fetching it.
        count = self.opencode_query(db, budget, 'SELECT count(*) FROM (SELECT 1 FROM %s WHERE %s LIMIT 2)' % (table, where), args)
        if count != [(1,)]:
            raise ValueError('opencode_record_malformed')
        rows = self.opencode_query(
            db, budget, 'SELECT CASE WHEN length(CAST(data AS BLOB)) = ? THEN data END FROM %s WHERE %s LIMIT 1' % (table, where),
            (size, *args))
        if len(rows) != 1 or not isinstance(rows[0][0], str):
            raise ValueError('opencode_record_malformed')
        return rows[0][0], fetched

    def opencode_scan_session(self, path, identity, native_id, repo_path, budget):
        fetched = 0
        emitted = 0
        db, fd = self.opencode_connect(path, identity, budget)
        try:
            db.execute('BEGIN')  # one read snapshot for the binding, the messages and their parts
            if self.opencode_identity(path) != identity:
                raise ValueError('opencode_db_replaced')
            bound = self.opencode_query(db, budget, 'SELECT 1 FROM session_v2 WHERE id=? AND directory=? LIMIT 2',
                                        (native_id, repo_path))
            # The snapshot is now open; the descriptor it reads through must still be the checked file.
            self.opencode_still_open(fd, identity)
            if len(bound) != 1:
                raise ValueError('opencode_session_missing' if not bound else 'opencode_session_ambiguous')
            # Sizes first, data later: no cell is materialized before its bytes fit the budget.
            messages = self.opencode_query(
                db, budget,
                'SELECT CASE WHEN length(CAST(id AS BLOB)) <= ? THEN id END, length(CAST(data AS BLOB)) '
                'FROM session_message WHERE session_id=? AND type=? ORDER BY seq LIMIT ?',
                (OC_ID_MAX, native_id, 'assistant', OC_MAX_MESSAGES + 1))
            if len(messages) > OC_MAX_MESSAGES:
                raise ValueError('opencode_guard_budget')
            parts_seen = 0
            for message_id, size in messages:
                if message_id is None:
                    raise ValueError('opencode_record_too_large')
                raw, fetched = self.opencode_cell(db, budget, size, fetched, 'session_message', 'id=?', (message_id,))
                parts = self.opencode_query(
                    db, budget,
                    "SELECT CASE WHEN typeof(ordinal)='integer' THEN ordinal END, "
                    'CASE WHEN length(CAST(type AS BLOB)) <= ? THEN type END, '
                    'length(CAST(data AS BLOB)) FROM session_part WHERE message_id=? ORDER BY ordinal LIMIT ?',
                    (OC_ID_MAX, message_id, OC_MAX_PARTS - parts_seen + 1))
                parts_seen += len(parts)
                if parts_seen > OC_MAX_PARTS:
                    raise ValueError('opencode_guard_budget')
                texts = []
                for ordinal, part_type, part_size in parts:
                    if ordinal is None:
                        raise ValueError('opencode_record_malformed')
                    if part_type is None:
                        raise ValueError('opencode_record_too_large')
                    if part_type != 'text':
                        continue
                    part_raw, fetched = self.opencode_cell(db, budget, part_size, fetched, 'session_part',
                                                           'message_id=? AND ordinal=?', (message_id, ordinal))
                    texts.append(_oc_text(_oc_json(part_raw)))
                budget.check()
                content = _oc_json(raw).get('content')
                if isinstance(content, list):
                    texts.extend(_oc_text(item) for item in content if isinstance(item, dict) and item.get('type') == 'text')
                for text in texts:
                    emitted += len(text.encode('utf-8', 'surrogatepass'))
                    if emitted > OC_TEXT_MAX:
                        raise ValueError('opencode_guard_budget')
                    found = _match(text)
                    if found:
                        return found
            budget.check()
        finally:
            db.close()
        return None

    def transcript(self, provider, repo_path, native_id):
        """Return the native transcript of one bound session, or fail closed."""
        if provider == 'claude-code':
            folder = '-' + repo_path.strip('/').replace('/', '-')
            path = pathlib.Path(self.config['native_project_root']) / folder / (native_id + '.jsonl')
        elif provider == 'codex-cli':
            # Codex writes one rollout per session under sessions/YYYY/MM/DD/,
            # and its file name ends with the session UUID. Check that exactly
            # one matches on every scan: a second rollout for the same session
            # must not go unread. The recorded path is informational only.
            root = pathlib.Path(self.config['codex_sessions_root'])
            found = sorted(root.glob('*/*/*/rollout-*-' + native_id + '.jsonl'))
            if len(found) != 1:
                raise FileNotFoundError('native_transcript_missing' if not found else 'native_transcript_ambiguous')
            path = found[0]
            self.state.setdefault('native_paths', {})[native_id] = str(path)
        elif provider == 'muse-cli':
            # Muse Code writes sessions/YYYY/MM/DD/<session uuid>/session.jsonl.
            # As for Codex, exactly one match must exist on every scan.
            root = pathlib.Path(self.config['muse_sessions_root'])
            found = sorted(root.glob('*/*/*/' + native_id + '/session.jsonl'))
            if len(found) != 1:
                raise FileNotFoundError('native_transcript_missing' if not found else 'native_transcript_ambiguous')
            path = found[0]
            self.state.setdefault('native_paths', {})[native_id] = str(path)
        elif provider == 'antigravity-cli':
            path = self.antigravity_transcript(native_id)
        else:
            raise ValueError('native_provider_unsupported')
        if not path.exists():
            raise FileNotFoundError('native_transcript_missing')
        return path

    def antigravity_transcript(self, native_id):
        """The agent's own agy transcript for one conversation, or fail closed (#984).

        The data root is the agent user's passwd home + .gemini/antigravity-cli, unless the
        config names it. Every directory on the way and both files must be the agent user's own,
        and nothing may be a symlink. presence/<id>.lock shows that the conversation is present;
        which process holds it can't be checked here, because another user's /proc fd table is
        not readable.
        """
        uid = self.config['agent_uid']
        configured = self.config.get('antigravity_data_root')
        root = pathlib.Path(configured) if configured else pathlib.Path(pwd.getpwuid(uid).pw_dir) / '.gemini' / 'antigravity-cli'

        def owned(path, kind, missing):
            try:
                info = os.lstat(path)
            except FileNotFoundError:
                raise FileNotFoundError(missing) from None
            if stat.S_IFMT(info.st_mode) != kind or info.st_uid != uid:
                raise ValueError('antigravity_path_unsafe')

        owned(root, stat.S_IFDIR, 'antigravity_data_root_missing')
        owned(root / 'presence', stat.S_IFDIR, 'antigravity_presence_missing')
        owned(root / 'presence' / (native_id + '.lock'), stat.S_IFREG, 'antigravity_presence_missing')
        folder = root
        for part in ['brain', native_id, '.system_generated', 'logs']:
            folder = folder / part
            owned(folder, stat.S_IFDIR, 'antigravity_transcript_missing')
        path = folder / 'transcript.jsonl'
        owned(path, stat.S_IFREG, 'antigravity_transcript_missing')
        return path

    def open_transcript(self, path, provider):
        if provider != 'antigravity-cli':
            return path.open('rb')
        # #1020 review: walk from the data root with one held directory descriptor per step, each
        # opened without following a link and proved by fstat, so the proof holds through the open.
        # A component replaced after it was opened no longer matters.
        uid = self.config['agent_uid']
        native_id = path.parents[2].name
        held = []

        def opened(name, dir_fd, kind, missing):
            flags = os.O_RDONLY | os.O_NOFOLLOW | (os.O_DIRECTORY if kind == stat.S_IFDIR else os.O_NONBLOCK)
            try:
                fd = os.open(name, flags, dir_fd=dir_fd)
            except FileNotFoundError:
                raise FileNotFoundError(missing) from None
            except OSError:
                raise ValueError('antigravity_path_unsafe') from None  # a link (ELOOP/ENOTDIR) or worse
            held.append(fd)
            info = os.fstat(fd)
            if stat.S_IFMT(info.st_mode) != kind or info.st_uid != uid:
                raise ValueError('antigravity_path_unsafe')
            return fd

        try:
            current = opened(str(path.parents[4]), None, stat.S_IFDIR, 'antigravity_data_root_missing')
            presence = opened('presence', current, stat.S_IFDIR, 'antigravity_presence_missing')
            try:
                lock = os.stat(native_id + '.lock', dir_fd=presence, follow_symlinks=False)
            except FileNotFoundError:
                raise FileNotFoundError('antigravity_presence_missing') from None
            if not stat.S_ISREG(lock.st_mode) or lock.st_uid != uid:
                raise ValueError('antigravity_path_unsafe')
            for part in ['brain', native_id, '.system_generated', 'logs']:
                current = opened(part, current, stat.S_IFDIR, 'antigravity_transcript_missing')
            final = opened('transcript.jsonl', current, stat.S_IFREG, 'antigravity_transcript_missing')
            held.remove(final)
            return os.fdopen(final, 'rb')
        finally:
            for fd in held:
                os.close(fd)

    def tick(self):
        if self.hold_path.exists():
            self.api('PATCH', '/agent-teams/presets/' + str(self.config['preset_id']), {'autonomy_enabled': False})
            for scope in self.config['scope_ids']:
                self.api('PATCH', '/agent-teams/github-scopes/' + str(scope), {'enabled': False})
            self.state.update(last_tick=now(), mode='WAITING_FOR_USER', autonomy_enabled=False)
            save(self.state_path, self.state)
            return
        preset = self.api('GET', '/agent-teams/presets/' + str(self.config['preset_id']))
        if {slot['id'] for slot in preset['slots'] if slot['enabled']} != set(self.config['slot_ids']):
            raise ValueError('configured_roster_changed')
        bindings = self.bindings()
        if not self.scan(bindings):
            return
        members = self.api('GET', '/agent-mail/team?sync=true')['members']
        connected = {m.get('team_slot_id') for m in members if m.get('team_preset_id') == self.config['preset_id'] and m.get('status') == 'connected' and m.get('wake_state') == 'wakeable'}
        # An on-demand slot (for example a reviewer launched at gates) may be stopped.
        # It is still scanned whenever it is bound.
        required = set(self.config['slot_ids']) - set(self.config.get('on_demand_slot_ids', []))
        missing = required - connected
        self.state['binding_failures'] = self.state.get('binding_failures', 0) + 1 if missing else 0
        if preset['autonomy_enabled'] and self.state['binding_failures'] >= 3:
            self.stop('authenticated_member_missing')
            return
        self.state.update(last_tick=now(), mode='SUPERVISING' if preset['autonomy_enabled'] else 'PREPARED_DISARMED', autonomy_enabled=preset['autonomy_enabled'], connected_slots=sorted(connected), missing_slots=sorted(missing), live_panes=len(bindings))
        save(self.state_path, self.state)

def run(supervisor):
    try:
        supervisor.tick()
    except Exception as exc:
        if supervisor.state.get('autonomy_enabled') or pathlib.Path(supervisor.config['armed_path']).exists():
            supervisor.stop('supervision_' + type(exc).__name__)
        else:
            supervisor.state.update(last_tick=now(), mode='STARTUP_GAP', error_type=type(exc).__name__)
            save(supervisor.state_path, supervisor.state)

if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--config', required=True)
    args = parser.parse_args()
    run(Supervisor(json.loads(pathlib.Path(args.config).read_text())))
